# ---------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env.local (ตอน dev) หรือ .env (ตอน deploy)
# ห้าม commit ไฟล์ที่มีค่าจริง และห้ามตั้งชื่อตัวแปรขึ้นต้นด้วย NEXT_PUBLIC_
# เพราะค่าเหล่านี้จะถูกฝังลงใน JavaScript ฝั่ง browser
# ---------------------------------------------------------------

# ฐานข้อมูล Postgres — เอามาจาก Supabase:
#   Project Settings → Database → Connection string → URI
#   (ไม่ใช่ anon key และไม่ใช่ service_role key)
#
# สำคัญ: ถ้า deploy บน Vercel หรือที่ไหนก็ตามที่เป็น serverless
# ให้ใช้ "Transaction pooler" พอร์ต 6543 ไม่ใช่ 5432
# ไม่งั้น connection ของ Postgres จะหมดภายในไม่กี่นาที
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 1 = บังคับ SSL (Supabase, Neon และ managed Postgres เกือบทุกเจ้า)
# 0 = ปิด SSL (Postgres ที่ลงเองบน VPS เครื่องเดียวกัน)
DATABASE_SSL=1

# รหัส PIN สำหรับเข้าแอป ตั้งเองได้ตามใจ แนะนำ 6 หลักขึ้นไป
# เปลี่ยนค่านี้เมื่อไหร่ คนที่ล็อกอินค้างไว้จะยังเข้าได้จนกว่า session จะหมดอายุ
# ถ้าต้องการเตะทุกคนออกทันที ให้เปลี่ยน AUTH_SECRET ด้วย
APP_PIN=

# กุญแจสำหรับเซ็น session cookie — ต้องยาวอย่างน้อย 32 ตัวอักษร
# สร้างด้วย:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ห้ามใช้ค่าเดียวกับ dev บน production และห้ามเปิดเผย
AUTH_SECRET=

# ---------------------------------------------------------------
# ไม่บังคับ
# ---------------------------------------------------------------

# ตั้งเมื่อจะวางแอปไว้ใต้ path ย่อย เช่น /ledger (ต้อง build ใหม่หลังเปลี่ยน)
# BASE_PATH=

# พอร์ตที่เซิร์ฟเวอร์ฟัง ปกติปล่อยว่างให้โฮสต์กำหนดเอง
# PORT=3000
